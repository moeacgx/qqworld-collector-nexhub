<?php
namespace qqworld_collector\module; use qqworld_collector\lib; class artificial_intelligence extends lib { var $options; var $config; var $module = 'artificial-intelligence'; var $settings_name = 'qqworld-collector-artificial-intelligence-settings'; public function __construct() { add_action( 'admin_init', array($this, 'register_settings') ); add_action( 'admin_menu', array($this, 'admin_menu') ); add_action( 'admin_enqueue_scripts', array($this, 'admin_enqueue_scripts') ); add_filter( 'qqworld-collector-script-translation-array', array($this, 'add_translation_array') ); $this->load_func(); add_action('qqworld-collector-register-activation-hook', array($this, 'activate')); add_action('qqworld-collector-register-deactivation-hook', array($this, 'deactivate')); $this->config = $this->load_provider_config(); } public function activate() { require QQWORLD_COLLECTOR_DIR . 'lib' . DIRECTORY_SEPARATOR . $this->module . DIRECTORY_SEPARATOR . 'class-activator.php'; \qqworld_collector\module\artificial_intelligence\QQWorld_AI_Activator::activate(); } public function deactivate() { require QQWORLD_COLLECTOR_DIR . 'lib' . DIRECTORY_SEPARATOR . $this->module . DIRECTORY_SEPARATOR . 'class-activator.php'; \qqworld_collector\module\artificial_intelligence\QQWorld_AI_Activator::deactivate(); } public function load_func() { require QQWORLD_COLLECTOR_DIR . 'lib' . DIRECTORY_SEPARATOR . $this->module . DIRECTORY_SEPARATOR . 'class-activator.php'; require QQWORLD_COLLECTOR_DIR . 'lib' . DIRECTORY_SEPARATOR . $this->module . DIRECTORY_SEPARATOR . 'class-chat-manager.php'; require QQWORLD_COLLECTOR_DIR . 'lib' . DIRECTORY_SEPARATOR . $this->module . DIRECTORY_SEPARATOR . 'class-context-manager.php'; require QQWORLD_COLLECTOR_DIR . 'lib' . DIRECTORY_SEPARATOR . $this->module . DIRECTORY_SEPARATOR . 'class-tool-handler.php'; require QQWORLD_COLLECTOR_DIR . 'lib' . DIRECTORY_SEPARATOR . $this->module . DIRECTORY_SEPARATOR . 'class-ajax-handler.php'; require QQWORLD_COLLECTOR_DIR . 'lib' . DIRECTORY_SEPARATOR . $this->module . DIRECTORY_SEPARATOR . 'class-api-handler.php'; $this->ensure_tables(); $Ajax_Handler = new \qqworld_collector\module\artificial_intelligence\QQWorld_AI_Ajax_Handler(); $Ajax_Handler->options = $this->options; } private function ensure_tables() { $current_version = get_option('qqworld_ai_db_version', '0'); if ($current_version !== \qqworld_collector\module\artificial_intelligence\QQWorld_AI_Activator::get_db_version()) { \qqworld_collector\module\artificial_intelligence\QQWorld_AI_Activator::activate(); } } public function register_settings() { register_setting($this->settings_name, $this->settings_name, array($this, 'parse_settings')); } public function parse_settings($settings) { if (isset($settings['image']['watermark-image']) && $settings['image']['watermark-image']) { update_post_meta($settings['image']['watermark-image'], '_added_watermark', 1); } return $settings; } public function admin_menu() { if ( !apply_filters( 'qqworld-collector-activated', false ) ) return; if ( apply_filters( 'qqworld-collector-activated-license', false ) && !apply_filters( 'qqworld-collector-activated-module-' . $this->module, false ) ) return; $parent_slug = 'qqworld-collector'; $page_title = __('Artificial Intelligence', $this->text_domain); $menu_title = $page_title; $capability = !$this->options->qc_authorization_all_roles_can_modify_settings ? 'manage_options' : $this->options->qc_authorization_who_can_use; $menu_slug = 'qqworld-collector-artificial-intelligence'; $function = array($this, 'artificial_intelligence'); $settings_page = add_submenu_page($parent_slug, $page_title, $menu_title, $capability, $menu_slug, $function); add_action( "load-{$settings_page}", array($this, 'help_tab') ); } public function artificial_intelligence() { require QQWORLD_COLLECTOR_DIR . 'pages' . DIRECTORY_SEPARATOR . 'artificial-intelligence.php'; } public function admin_enqueue_scripts() { $screen = get_current_screen(); if (strstr($screen->id, 'qqworld-collector-artificial-intelligence')) { wp_enqueue_style('animate'); wp_enqueue_script('noty'); wp_enqueue_style('noty'); wp_enqueue_script('showdown'); wp_enqueue_script('qqworld-collector-artificial-intelligence-admin'); wp_enqueue_style('qqworld-collector-artificial-intelligence-admin'); } } public function add_translation_array($translation_array) { $translation_array['nonce'] = wp_create_nonce('qqworld_ai_nonce'); $translation_array['providerConfig'] = $this->get_enabled_provider_config(); $translation_array['text']['newChat'] = __('New Session', $this->text_domain); $translation_array['text']['deleteChat'] = __('Delete Session', $this->text_domain); $translation_array['text']['send'] = __('Send', $this->text_domain); $translation_array['text']['thinking'] = __('Thinking...', $this->text_domain); $translation_array['text']['error'] = __('An error occurred', $this->text_domain); $translation_array['text']['selectModel'] = __('Choose a model', $this->text_domain); $translation_array['text']['noMessages'] = __("Let's start the conversation", $this->text_domain); $translation_array['text']['confirmDelete'] = __('Are you sure you want to delete this conversation?', $this->text_domain); return $translation_array; } private function load_provider_config() { $config_file = WP_CONTENT_DIR . DIRECTORY_SEPARATOR . 'provider.json'; if (!file_exists($config_file)) { return array(); } $config = json_decode(file_get_contents($config_file), true); if (json_last_error() !== JSON_ERROR_NONE) { return array(); } return $config; } private function get_enabled_provider_config() { $enabled_providers = array(); $enabled_providers = apply_filters( 'qqworld-collector-artificial-intelligence-enabled-provider-config', $enabled_providers, $this->config ); foreach ($this->config as $provider_name => $provider_data) { $enabled_models = array(); if (isset($provider_data['models']) && is_array($provider_data['models'])) { foreach ($provider_data['models'] as $model) { if (isset($model['enabled']) && $model['enabled'] === true) { $enabled_models[] = array( 'name' => $model['name'], 'label' => $model['label'], 'ctx' => $model['ctx'], 'tools' => $model['tools'] ?? false, 'vision' => $model['vision'] ?? false, ); } } } if (!empty($enabled_models)) { $enabled_providers[$provider_name] = array( 'api' => $provider_data['api'], 'apikey' => $provider_data['apikey'], 'models' => $enabled_models, ); } } return $enabled_providers; } } ?>